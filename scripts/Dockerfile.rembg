FROM python:3.11-slim

ARG REMBG_VERSION=2.0.72

RUN pip install --no-cache-dir "rembg[cpu,cli]==${REMBG_VERSION}"

ENV NUMBA_DISABLE_JIT=1
ENV HOME=/tmp

# Pre-download U2Net model and make world-readable
# (docker run --user UID:GID changes the runtime user, so root-owned build files need open perms)
RUN python -c "from rembg import new_session; new_session('u2net')" \
    && chmod -R a+rX /tmp/.u2net

ENTRYPOINT ["rembg", "i"]
