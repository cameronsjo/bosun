---
import BaseLayout from '../layouts/BaseLayout.astro';
import { base } from '../lib/base';

const glossary = [
  { term: 'Bosun', def: 'CLI tool and orchestrator — receives orders, deploys containers.' },
  { term: 'Manifest', def: 'Service definitions (the crew manifest).' },
  { term: 'Provisions', def: 'Reusable config templates, stocked aboard.' },
  { term: 'Captain', def: 'GitHub — gives orders.' },
  { term: 'Radio', def: 'Webhook or tunnel (Tailscale Funnel or Cloudflare Tunnel).' },
  { term: 'Crew', def: 'Containers.' },
  { term: 'Yacht', def: 'The server or host running Docker Compose.' },
];
---

<BaseLayout title="Home" description="GitOps for Docker Compose on bare metal — Helm for home.">
  <section class="hero">
    <img src={`${base}bosun-mascot.png`} alt="Bosun mascot" width="220" height="220" />
    <p class="eyebrow">GitOps for Docker Compose · no Kubernetes required</p>
    <h1>Bosun</h1>
    <p class="tagline">Push to git. Bosun receives orders. Containers deploy.<br />Smooth sailing.</p>
    <div class="cta-row">
      <a class="btn-brass" href={`${base}docs/`}>Read the docs</a>
      <a class="btn-quiet" href="https://github.com/cameronsjo/bosun">GitHub</a>
    </div>
  </section>

  <div class="rope-divider" role="presentation"></div>

  <section class="prose">
    <div class="maritime-card-accent quickstart">
      <p class="eyebrow">Quickstart</p>
      <pre><code>{`bosun init      # interactive setup wizard
bosun doctor    # pre-flight checks
bosun daemon    # run the GitOps daemon`}</code></pre>
      <p class="quickstart-links">
        See <a href={`${base}docs/commands/`}>Commands</a> for the full CLI reference and
        <a href={`${base}docs/concepts/`}>Concepts</a> for the architecture.
      </p>
    </div>
  </section>

  <section class="glossary-section">
    <h2>Nautical Glossary</h2>
    <div class="glossary">
      {glossary.map((entry) => (
        <div class="maritime-card glossary-card">
          <p class="term">{entry.term}</p>
          <p class="def">{entry.def}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3.5rem 1rem 1rem;
  }

  .hero img {
    border-radius: 12px;
    filter: drop-shadow(0 8px 24px rgba(26, 39, 68, 0.18));
  }

  .hero .eyebrow {
    margin: 1.5rem 0 0.25rem;
    letter-spacing: 0.18em;
  }

  .hero h1 {
    font-size: 4rem;
    font-weight: 500;
    margin: 0 0 0.75rem;
  }

  .tagline {
    color: var(--text-secondary);
    font-size: 1.2rem;
    line-height: 1.7;
    margin: 0 0 2rem;
  }

  .cta-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .prose {
    max-width: 44rem;
    margin: 0 auto;
  }

  .quickstart {
    padding: 1.5rem;
  }

  .quickstart .eyebrow {
    margin: 0 0 0.75rem;
  }

  .quickstart pre {
    margin: 0;
  }

  .quickstart-links {
    margin: 1rem 0 0;
    color: var(--text-secondary);
  }

  .glossary-section {
    max-width: 60rem;
    margin: 4rem auto 2rem;
    padding: 0 1rem;
  }

  .glossary-section h2 {
    text-align: center;
    font-size: 1.75rem;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .glossary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .glossary-card {
    padding: 1rem 1.25rem;
  }

  .glossary-card .term {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brass-dark);
    margin: 0 0 0.375rem;
  }

  .glossary-card .def {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
